<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OSIS Sekolah Indonesia Bangkok</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --red:#D8232A;
    --red-dark:#AD1A20;
    --navy:#0F1B33;
    --navy-2:#182A4D;
    --ink:#151A22;
    --gray:#5C6470;
    --gray-light:#8A93A0;
    --line:#E7E4DD;
    --cream:#F6F4EF;
    --gold:#C8973E;
    --white:#FFFFFF;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4,.brand-name,.stat-num{font-family:'Plus Jakarta Sans',sans-serif;}
  a{text-decoration:none;color:inherit;}
  ul{list-style:none;margin:0;padding:0;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1220px;margin:0 auto;padding:0 32px;}
  @media(max-width:640px){.wrap{padding:0 20px;}}

  :focus-visible{outline:2px solid var(--red);outline-offset:2px;}

  /* ---------- NAV ---------- */
  header.site-nav{
    position:sticky;top:0;z-index:100;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 0;
  }
  .brand{display:flex;align-items:center;gap:12px;}
  .crest{
    width:46px;height:46px;border-radius:50%;
    background:conic-gradient(from 180deg,var(--red),var(--gold),var(--red));
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-weight:800;font-size:13px;letter-spacing:.5px;
    flex-shrink:0;
    box-shadow:inset 0 0 0 3px rgba(255,255,255,.5);
  }
  .crest-img{
    background:none;box-shadow:none;object-fit:contain;padding:2px;
  }
  .brand-text .brand-name{font-size:16px;font-weight:800;line-height:1.15;color:var(--navy);letter-spacing:.2px;}
  .brand-text .brand-sub{font-size:11px;color:var(--gray);font-weight:600;}
  .brand-text .brand-tag{font-size:10.5px;color:var(--gray-light);margin-top:1px;}
  nav.main-links{display:flex;gap:30px;align-items:center;}
  nav.main-links a{
    font-size:14.5px;font-weight:600;color:var(--ink);
    padding:6px 0;border-bottom:2px solid transparent;
    transition:color .15s, border-color .15s;
  }
  nav.main-links a:hover{color:var(--red);}
  nav.main-links a.active{color:var(--red);border-color:var(--red);}
  .nav-actions{display:flex;align-items:center;gap:16px;}
  .icon-btn{
    width:40px;height:40px;border-radius:50%;background:var(--cream);
    display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;
    color:var(--navy);
  }
  .btn-login{
    background:var(--red);color:#fff;font-weight:700;font-size:14px;
    padding:11px 20px;border-radius:999px;display:flex;align-items:center;gap:8px;
    border:none;cursor:pointer;transition:background .15s;
  }
  .btn-login:hover{background:var(--red-dark);}
  .burger{display:none;background:none;border:none;cursor:pointer;padding:6px;}
  .burger span{display:block;width:24px;height:2px;background:var(--navy);margin:5px 0;}

  @media(max-width:980px){
    nav.main-links{
      position:fixed;inset:70px 0 0 0;background:#fff;flex-direction:column;
      padding:24px 32px;gap:4px;align-items:stretch;
      transform:translateY(-110%);opacity:0;transition:transform .25s ease, opacity .2s ease;
      border-top:1px solid var(--line);
    }
    nav.main-links.open{transform:translateY(0);opacity:1;}
    nav.main-links a{padding:14px 4px;border-bottom:1px solid var(--line);}
    .burger{display:block;}
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;overflow:hidden;
    min-height:560px;display:flex;align-items:center;
    background:
      linear-gradient(100deg, rgba(15,27,51,.93) 0%, rgba(15,27,51,.80) 42%, rgba(15,27,51,.45) 100%),
      url('data:image/jpeg;base64,') center 38% / cover no-repeat;
    color:#fff;
  }
  .hero-inner{
    position:relative;z-index:2;
    padding:88px 0 96px;
    max-width:640px;
  }
  .hero-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:13px;font-weight:700;color:var(--gold);
    margin-bottom:18px;
  }
  .hero-eyebrow::before{content:"";width:22px;height:2px;background:var(--gold);display:inline-block;}
  .hero h1{
    font-size:52px;line-height:1.04;font-weight:800;margin:0 0 6px;letter-spacing:-.5px;
  }
  .hero h1 .accent{color:var(--red);display:block;}
  .hero p{
    font-size:17px;line-height:1.65;color:#C9CFDC;max-width:480px;margin:22px 0 34px;
  }
  .btn-cta{
    display:inline-flex;align-items:center;gap:10px;
    background:var(--red);color:#fff;font-weight:700;font-size:15px;
    padding:16px 26px;border-radius:10px;transition:transform .15s, background .15s;
  }
  .btn-cta:hover{background:var(--red-dark);transform:translateY(-1px);}
  @media(max-width:760px){
    .hero{min-height:420px;}
    .hero-inner{padding:56px 0 72px;}
    .hero h1{font-size:36px;}
  }

  /* ---------- FEATURE STRIP ---------- */
  .feature-strip{
    margin-top:-44px;position:relative;z-index:5;
    display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
    max-width:900px;margin-left:auto;margin-right:auto;
  }
  @media(max-width:760px){.feature-strip{grid-template-columns:1fr;}}
  .feature-card{
    background:#fff;border:1px solid var(--line);border-radius:16px;
    padding:26px 20px;text-align:center;cursor:pointer;
    box-shadow:0 14px 30px -18px rgba(15,27,51,.25);
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .feature-card:hover{transform:translateY(-4px);box-shadow:0 18px 34px -16px rgba(15,27,51,.32);}
  .f-icon{
    width:52px;height:52px;border-radius:14px;margin:0 auto 14px;
    display:flex;align-items:center;justify-content:center;color:#fff;
  }
  .feature-card h4{font-size:15.5px;margin:0 0 6px;color:var(--navy);}
  .feature-card p{font-size:13px;color:var(--gray);line-height:1.5;margin:0;}

  section{padding:96px 0;scroll-margin-top:84px;}
  section.tight{padding-top:80px;}
  .section-head{margin-bottom:44px;max-width:640px;}
  .kicker{
    display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;
    color:var(--red);margin-bottom:12px;
  }
  .kicker::before{content:"";width:4px;height:16px;background:var(--red);border-radius:2px;}
  .section-head h2{font-size:32px;font-weight:800;color:var(--navy);margin:0 0 10px;letter-spacing:-.3px;}
  .section-head p{font-size:15.5px;color:var(--gray);line-height:1.7;margin:0;}
  .head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;}
  .link-more{font-size:14px;font-weight:700;color:var(--red);display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}

  .bg-cream{background:var(--cream);}

  /* ---------- NEWS + CALENDAR ---------- */
  .news-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  @media(max-width:980px){.news-cards{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:640px){.news-cards{grid-template-columns:1fr;}}
  .news-card{
    background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;
    transition:box-shadow .18s ease, transform .18s ease;
  }
  .news-card:hover{box-shadow:0 16px 30px -18px rgba(15,27,51,.28);transform:translateY(-3px);}
  .news-thumb{height:140px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:34px;}
  .news-body{padding:18px 18px 20px;}
  .news-date{font-size:12px;color:var(--red);font-weight:700;display:flex;align-items:center;gap:6px;margin-bottom:10px;}
  .news-body h4{font-size:15.5px;margin:0 0 8px;color:var(--navy);line-height:1.4;}
  .news-body p{font-size:13px;color:var(--gray);line-height:1.6;margin:0;}

  .calendar-card{
    background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;
  }
  .cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
  .cal-title{display:flex;align-items:center;gap:8px;font-weight:800;color:var(--navy);font-size:15px;}
  .cal-nav{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--gray);}
  .cal-nav button{background:none;border:none;cursor:pointer;color:var(--gray);font-size:16px;}
  table.cal-table{width:100%;border-collapse:collapse;font-size:13px;}
  table.cal-table th{color:var(--gray-light);font-weight:600;padding:6px 0;font-size:11.5px;}
  table.cal-table td{text-align:center;padding:7px 0;color:var(--ink);border-radius:8px;}
  table.cal-table td.muted{color:#D8D5CC;}
  table.cal-table td.today{background:var(--red);color:#fff;font-weight:700;border-radius:50%;}
  .cal-event{
    margin-top:16px;background:var(--cream);border-radius:12px;padding:14px 16px;
    display:flex;gap:10px;align-items:flex-start;
  }
  .cal-event .dot{width:8px;height:8px;border-radius:50%;background:var(--red);margin-top:6px;flex-shrink:0;}
  .cal-event strong{display:block;font-size:12.5px;color:var(--gray);font-weight:700;}
  .cal-event span{font-size:13.5px;color:var(--navy);font-weight:600;}

  /* ---------- ABOUT ---------- */
  .about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center;}
  @media(max-width:900px){.about-grid{grid-template-columns:1fr;gap:36px;}}
  .about-visual{
    background:linear-gradient(160deg,var(--navy),var(--navy-2));
    border-radius:20px;padding:40px;color:#fff;position:relative;overflow:hidden;
    min-height:360px;display:flex;flex-direction:column;justify-content:space-between;
  }
  .about-visual::after{
    content:"";position:absolute;right:-40px;bottom:-40px;width:200px;height:200px;
    border-radius:50%;background:radial-gradient(circle,rgba(216,35,42,.35),transparent 70%);
  }
  .about-quote{font-size:19px;line-height:1.6;font-weight:600;position:relative;z-index:2;}
  .about-stats{display:grid;grid-template-columns:1fr 1fr;gap:20px 24px;position:relative;z-index:2;margin-top:24px;}
  .stat-num{font-size:34px;font-weight:800;color:var(--gold);}
  .stat-label{font-size:12px;color:#B7BEC E;color:#B9C0CE;margin-top:2px;}
  .about-text h3{font-size:14px;text-transform:none;color:var(--red);font-weight:700;margin:0 0 14px;}
  .about-text p{font-size:15.5px;line-height:1.8;color:var(--gray);margin:0 0 18px;}
  .value-list{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px;}
  .value-item{display:flex;gap:12px;align-items:flex-start;}
  .value-dot{
    width:30px;height:30px;border-radius:9px;background:var(--cream);color:var(--red);
    display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;
  }
  .value-item p{margin:0;font-size:13.5px;color:var(--navy);font-weight:600;line-height:1.4;}

  /* ---------- BIDANG ---------- */
  .bidang-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  @media(max-width:980px){.bidang-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:560px){.bidang-grid{grid-template-columns:1fr;}}
  .bidang-card{
    background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px 22px;
    transition:border-color .18s ease, transform .18s ease;cursor:pointer;
  }
  .bidang-card:hover{border-color:var(--red);transform:translateY(-3px);}
  .bidang-num{font-size:12px;font-weight:800;color:var(--gray-light);margin-bottom:14px;letter-spacing:.5px;}
  .bidang-card h4{font-size:16px;color:var(--navy);margin:0 0 8px;}
  .bidang-card p{font-size:13.3px;color:var(--gray);line-height:1.6;margin:0;}
  .bidang-card .bidang-arrow{
    margin-top:14px;display:inline-flex;align-items:center;gap:6px;
    font-size:12.5px;font-weight:700;color:var(--red);
  }

  /* ---------- BIDANG DETAIL PAGE ---------- */
  .bidang-detail-hero{
    background:linear-gradient(120deg,var(--navy),var(--navy-2));
    color:#fff;padding:64px 0 56px;
  }
  .bidang-detail-num{font-size:13px;font-weight:700;color:var(--gold);letter-spacing:.5px;margin-bottom:14px;}
  .bidang-detail-hero h1{font-size:34px;margin:0 0 12px;}
  .bidang-detail-hero p{font-size:15.5px;color:#C9CFDC;margin:0;max-width:560px;line-height:1.6;}

  /* ---------- JADWAL ---------- */
  .timeline{position:relative;padding-left:2px;}
  .timeline::before{content:"";position:absolute;left:60px;top:8px;bottom:8px;width:2px;background:var(--line);}
  @media(max-width:640px){.timeline::before{left:22px;}}
  .t-row{display:grid;grid-template-columns:120px 1fr;gap:24px;position:relative;padding-bottom:34px;}
  @media(max-width:640px){.t-row{grid-template-columns:44px 1fr;gap:14px;}}
  .t-row:last-child{padding-bottom:0;}
  .t-day{font-size:13px;font-weight:700;color:var(--gray);text-align:right;padding-top:4px;}
  @media(max-width:640px){.t-day{display:none;}}
  .t-dot{
    position:absolute;left:56px;top:6px;width:10px;height:10px;border-radius:50%;
    background:var(--red);box-shadow:0 0 0 4px #fff;
  }
  @media(max-width:640px){.t-dot{left:18px;}}
  .t-card{
    background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 22px;
    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;
  }
  .t-card h4{margin:0 0 4px;font-size:15.5px;color:var(--navy);}
  .t-card p{margin:0;font-size:13px;color:var(--gray);}
  .t-tag{
    font-size:11.5px;font-weight:700;padding:6px 12px;border-radius:999px;white-space:nowrap;
  }
  .tag-akademik{background:#E9F1FF;color:#2A5FCC;}
  .tag-ekskul{background:#FFF1E5;color:#C77A16;}
  .tag-nasional{background:#FDE8E8;color:var(--red);}
  .tag-rapat{background:#EDF7EE;color:#2E8B45;}

  /* ---------- INFORMASI ---------- */
  .info-list{display:flex;flex-direction:column;gap:16px;}
  .info-item{
    display:flex;gap:20px;align-items:flex-start;background:#fff;border:1px solid var(--line);
    border-radius:14px;padding:22px 24px;
  }
  .info-badge{
    width:46px;height:46px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;
    justify-content:center;color:#fff;font-weight:800;font-size:13px;
  }
  .info-item h4{margin:0 0 6px;font-size:15.5px;color:var(--navy);}
  .info-item p{margin:0;font-size:13.5px;color:var(--gray);line-height:1.6;}
  .info-meta{font-size:12px;color:var(--gray-light);margin-top:8px;font-weight:600;}

  /* ---------- PROGRAM ---------- */
  .program-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  @media(max-width:900px){.program-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:600px){.program-grid{grid-template-columns:1fr;}}
  .program-card{
    border-radius:18px;padding:28px 24px;color:#fff;position:relative;overflow:hidden;
    min-height:210px;display:flex;flex-direction:column;justify-content:flex-end;
  }
  .program-card::before{
    content:"";position:absolute;inset:0;background:linear-gradient(200deg,rgba(0,0,0,0),rgba(0,0,0,.35));
  }
  .program-card h4{position:relative;z-index:2;font-size:18px;margin:0 0 8px;}
  .program-card p{position:relative;z-index:2;font-size:13px;line-height:1.6;margin:0;color:rgba(255,255,255,.88);}
  .program-tag{
    position:relative;z-index:2;align-self:flex-start;font-size:11px;font-weight:700;
    background:rgba(255,255,255,.18);padding:5px 12px;border-radius:999px;margin-bottom:14px;
    backdrop-filter:blur(4px);
  }

  /* ---------- CTA BAND ---------- */
  .cta-band{
    background:linear-gradient(120deg,var(--navy),var(--navy-2));
    border-radius:26px;padding:56px 48px;color:#fff;
    display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap;
    position:relative;overflow:hidden;
  }
  .cta-band::after{
    content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;
    background:radial-gradient(circle,rgba(216,35,42,.4),transparent 70%);
  }
  .cta-band h3{font-size:26px;margin:0 0 8px;position:relative;z-index:2;}
  .cta-band p{margin:0;color:#C3CAD8;font-size:14.5px;position:relative;z-index:2;max-width:420px;}
  .cta-band .btn-cta{position:relative;z-index:2;flex-shrink:0;}

  /* ---------- FOOTER ---------- */
  footer{background:var(--navy);color:#B9C0CE;padding:64px 0 28px;margin-top:40px;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;padding-bottom:44px;border-bottom:1px solid rgba(255,255,255,.1);}
  @media(max-width:900px){.foot-grid{grid-template-columns:1fr 1fr;}}
  @media(max-width:560px){.foot-grid{grid-template-columns:1fr;}}
  .foot-brand{display:flex;gap:12px;margin-bottom:16px;}
  .foot-brand .brand-name{color:#fff;font-size:15px;font-weight:800;}
  .foot-brand .brand-sub{font-size:11px;color:#8891A2;}
  footer p.desc{font-size:13.5px;line-height:1.7;color:#8B93A4;max-width:280px;}
  footer h5{color:#fff;font-size:13.5px;margin:0 0 18px;}
  footer ul li{margin-bottom:11px;}
  footer ul li a{font-size:13.5px;color:#AEB5C4;transition:color .15s;}
  footer ul li a:hover{color:#fff;}
  .foot-bottom{padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:12.5px;color:#7A8395;}

  .reveal{opacity:0;transform:translateY(16px);transition:opacity .5s ease, transform .5s ease;}
  .reveal.in{opacity:1;transform:none;}
  @media (prefers-reduced-motion:reduce){
    .reveal{opacity:1;transform:none;transition:none;}
    html{scroll-behavior:auto;}
  }
</style>
</head>
<body>

<div id="mainView">
<header class="site-nav">
  <div class="wrap nav-inner">
    <a href="#home" class="brand">
      <img src="data:image/png;base64," alt="Logo OSIS SIB" class="crest crest-img">
      <div class="brand-text">
        <div class="brand-name">SIB Youth Hub</div>
        <div class="brand-sub">SEKOLAH INDONESIA BANGKOK</div>
        <div class="brand-tag">GROW, LEAD, MAKE IMPACT!</div>
      </div>
    </a>
    <nav class="main-links" id="mainNav">
      <a href="#home" class="active">Home</a>
      <a href="#tentang">Tentang Kami</a>
      <a href="#bidang">Bidang OSIS</a>
    </nav>
    <div class="nav-actions">
      <button class="icon-btn" aria-label="Cari" onclick="alert('Fitur pencarian akan segera hadir.')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <button class="burger" id="burgerBtn" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="hero" id="home" style="padding-bottom:0;">
  <div class="wrap">
    <div class="hero-inner">
      <div class="hero-eyebrow">TAHUN AJARAN 2026 / 2027</div>
      <h1>OSIS<span class="accent">SEKOLAH INDONESIA BANGKOK</span></h1>
      <p>GROW • LEAD • MAKE IMPACT</p>
      <a href="#bidang" class="btn-cta">Jelajahi Kegiatan OSIS
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="feature-strip reveal" id="featureStrip">
    <a href="#tentang" class="feature-card">
      <div class="f-icon" style="background:var(--red);">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M11 5.9 3 21h18L11 5.9Z"/><path d="M11 5.9 15 3l1 3.3"/></svg>
      </div>
      <h4>Profil OSIS</h4>
