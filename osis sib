<script>
  // ---- Bidang OSIS detail pages ----
  const bidangData = {
    agama: {
      num: 'BIDANG 01', title: 'Agama',
      tagline: 'Membina keimanan, ketakwaan, dan kehidupan spiritual siswa.',
      desc: 'Bidang Agama bertanggung jawab mengelola seluruh kegiatan keagamaan di lingkungan sekolah serta membina spiritualitas siswa dari berbagai latar belakang agama, agar tumbuh menjadi pribadi yang bertakwa dan berakhlak mulia.',
      programs: [
        ['Kajian & Ibadah Rutin', 'Menyelenggarakan kajian, doa bersama, dan ibadah rutin sesuai agama masing-masing siswa.'],
        ['Peringatan Hari Besar Keagamaan', 'Mengelola perayaan dan peringatan hari besar keagamaan di sekolah.'],
        ['Pembinaan Rohani', 'Mendampingi siswa dalam kegiatan pembinaan rohani dan pengembangan karakter.']
      ]
    },
    olahraga: {
      num: 'BIDANG 02', title: 'Olahraga',
      tagline: 'Menggerakkan semangat sehat, aktif, dan sportif di sekolah.',
      desc: 'Bidang Olahraga mengelola seluruh kegiatan keolahragaan dan gaya hidup sehat di lingkungan sekolah, mulai dari latihan rutin hingga turnamen antar kelas, untuk membangun kebugaran dan sportivitas siswa.',
      programs: [
        ['SIB Cup', 'Menyelenggarakan turnamen olahraga antar kelas setiap tahun.'],
        ['Latihan Ekstrakurikuler', 'Mengoordinasikan jadwal latihan rutin cabang olahraga sekolah.'],
        ['Kampanye Hidup Sehat', 'Mengajak warga sekolah menerapkan gaya hidup aktif dan sehat.']
      ]
    },
    humas: {
      num: 'BIDANG 03', title: 'Humas',
      tagline: 'Menjembatani komunikasi antara OSIS, siswa, dan sekolah.',
      desc: 'Bidang Humas berperan sebagai penghubung informasi antara pengurus OSIS, siswa, guru, dan pihak sekolah, memastikan setiap kegiatan dan pengumuman tersampaikan dengan jelas kepada seluruh warga sekolah.',
      programs: [
        ['Koordinasi Informasi', 'Menyebarkan informasi dan pengumuman resmi OSIS ke seluruh siswa.'],
        ['Relasi Antar Bidang', 'Menjembatani komunikasi dan kerja sama antar bidang OSIS.'],
        ['Penghubung ke Sekolah', 'Menjadi perwakilan siswa dalam komunikasi dengan pihak sekolah.']
      ]
    },
    cta: {
      num: 'BIDANG 04', title: 'CTA (Cinta Tanah Air)',
      tagline: 'Menumbuhkan rasa nasionalisme dan kecintaan pada bangsa.',
      desc: 'Bidang CTA menumbuhkan rasa cinta tanah air dan semangat kebangsaan di lingkungan sekolah Indonesia di Bangkok, melalui kegiatan yang menjaga nilai-nilai nasionalisme dan budaya Indonesia.',
      programs: [
        ['Upacara Bendera', 'Mengoordinasikan pelaksanaan upacara bendera dan peringatan hari nasional.'],
        ['Bazar Kemerdekaan', 'Menyelenggarakan kegiatan peringatan HUT RI setiap tahun.'],
        ['Pelestarian Budaya', 'Mendorong kegiatan yang menjaga budaya dan identitas Indonesia.']
      ]
    },
    kwh: {
      num: 'BIDANG 05', title: 'KWH (Kewirausahaan)',
      tagline: 'Mengelola kedai sekolah dan menumbuhkan jiwa wirausaha siswa.',
      desc: 'Bidang KWH bertanggung jawab mengelola dan menjaga kedai sekolah sebagai sarana wirausaha siswa, sekaligus menumbuhkan jiwa kewirausahaan melalui pengalaman berjualan dan mengelola usaha kecil di lingkungan sekolah.',
      programs: [
        ['Pengelolaan Kedai Sekolah', 'Menjaga operasional harian kedai sekolah, mulai dari stok hingga kebersihan.'],
        ['Pencatatan Keuangan', 'Mencatat pemasukan dan pengeluaran kedai secara rutin.'],
        ['Pelatihan Wirausaha', 'Memberikan pengalaman berwirausaha langsung bagi pengurus dan siswa.']
      ]
    },
    jurnalistik: {
      num: 'BIDANG 06', title: 'Jurnalistik',
      tagline: 'Mengelola publikasi, dokumentasi, dan media digital OSIS.',
      desc: 'Bidang Jurnalistik mengelola seluruh publikasi berita, dokumentasi kegiatan, dan media digital OSIS, agar setiap momen dan informasi penting dapat terekam dan tersampaikan dengan baik kepada warga sekolah.',
      programs: [
        ['Dokumentasi Kegiatan', 'Mendokumentasikan setiap kegiatan dan acara OSIS dalam bentuk foto dan video.'],
        ['Media Sosial OSIS', 'Mengelola akun media sosial resmi OSIS untuk publikasi berita.'],
        ['Penulisan Berita', 'Menulis dan menerbitkan berita seputar kegiatan sekolah dan OSIS.']
      ]
    }
  };

  function openBidangPage(id){
    const data = bidangData[id];
    if (!data) return;
    document.getElementById('bidangDetailNum').textContent = data.num;
    document.getElementById('bidangDetailTitle').textContent = data.title;
    document.getElementById('bidangDetailTagline').textContent = data.tagline;
    document.getElementById('bidangDetailDesc').textContent = data.desc;

    const badgeColors = ['var(--red)', '#1B3A7A', '#1F8A5C'];
    const list = document.getElementById('bidangDetailPrograms');
    list.innerHTML = data.programs.map((p, i) => `
      <div class="info-item">
        <div class="info-badge" style="background:${badgeColors[i % badgeColors.length]};">${i + 1}</div>
        <div>
          <h4>${p[0]}</h4>
          <p>${p[1]}</p>
        </div>
      </div>
    `).join('');

    const mainLogo = document.querySelector('#mainView .crest-img');
    const detailLogo = document.getElementById('detailLogoImg');
    if (mainLogo && detailLogo) detailLogo.src = mainLogo.src;

    document.getElementById('mainView').style.display = 'none';
    document.getElementById('bidangPage').style.display = 'block';
    window.scrollTo(0, 0);
  }

  function closeBidangPage(){
    document.getElementById('bidangPage').style.display = 'none';
    document.getElementById('mainView').style.display = 'block';
    window.scrollTo(0, 0);
  }

  // Mobile nav toggle
  const burger = document.getElementById('burgerBtn');
  const mainNav = document.getElementById('mainNav');
  burger.addEventListener('click', () => mainNav.classList.toggle('open'));
  mainNav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mainNav.classList.remove('open')));

  // Active link on scroll
  const sections = document.querySelectorAll('section[id], div.hero#home');
  const navLinks = document.querySelectorAll('nav.main-links a');
  const setActive = () => {
    let current = 'home';
    document.querySelectorAll('section[id]').forEach(sec => {
      const rect = sec.getBoundingClientRect();
      if (rect.top <= 120 && rect.bottom > 120) current = sec.id;
    });
    if (window.scrollY < 80) current = 'home';
    navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + current));
  };
  window.addEventListener('scroll', setActive);
  setActive();

  // Reveal on scroll
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

